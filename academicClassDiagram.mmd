%% Diagramme de classes de conception - version academique
%% Objectif: lisibilite, structuration par couches, et metier central.

namespace Domaine {
  class BaseEntity {
    <<abstract>>
    +Long id
    +LocalDateTime createdDate
    +LocalDateTime lastModifiedDate
    +String createdBy
    +String lastModifiedBy
    +Long version
  }

  class TPE {
    +TypeTPE typeTPE
    +String numeroSerie
    +String numeroTerminal
    +StatutTPE statut
    +String marque
    +String modele
    +LocalDate dateAcquisition
    +LocalDate dateMiseEnService
    +String mcc
    +String numeroAffiliation
    +String commentaire
  }

  class Commercant {
    +String raisonSociale
    +String activite
    +String numeroCompte
    +String adresse
    +String codeAgence
    +String telephone
    +String email
    +StatutCommercant statut
    +Double loyer
    +TypeTPE typeCommerce
  }

  class Demande {
    +String reference
    +TypeTPE typeDemande
    +StatutDemande statut
    +Urgence urgence
    +String description
    +String commentaireValidation
    +String numeroTerminal
    +String urlSiteMarchand
  }

  class Affectation {
    +LocalDate dateAffectation
    +LocalDate dateMiseEnService
    +LocalDate dateFin
    +Boolean actif
    +String bonLivraisonPath
    +String contratPath
  }

  class Panne {
    +String reference
    +StatutPanne statut
    +String description
    +LocalDateTime dateDeclaration
    +LocalDateTime dateDiagnostic
    +LocalDateTime dateReparation
    +LocalDateTime dateResolution
    +Double coutReparation
    +Boolean sousGarantie
  }

  class Taux {
    +Double ancienTauxCommission
    +Double nouveauTauxCommission
    +Double ancienTauxCommissionInter
    +Double nouveauTauxCommissionInter
    +StatutTaux statut
    +LocalDateTime dateSaisie
    +LocalDateTime dateValidation
    +LocalDateTime dateApplication
    +Boolean actif
  }

  class User {
    +String username
    +String nom
    +String prenom
    +String email
    +String telephone
    +String codeAgence
    +Boolean actif
  }

  class Role {
    +Long id
    +RoleType name
    +String description
  }

  class Screen {
    +String code
    +String libelle
    +String route
    +String icon
    +Integer ordre
    +Boolean actif
  }

  class HistoriqueStatut {
    +Long id
    +StatutTPE ancienStatut
    +StatutTPE nouveauStatut
    +LocalDateTime dateChangement
    +String changePar
  }

  class Commentaire {
    +String contenu
    +Boolean interne
  }

  class PieceJointe {
    +String nomFichier
    +String cheminFichier
    +String typeMime
    +Long tailleFichier
  }

  class PieceDetachee {
    +String designation
    +Integer quantite
    +Double prixUnitaire
    +Double prixTotal
  }

  class AuditLog {
    +LocalDateTime dateAction
    +String username
    +String action
    +String entityType
    +String entityId
    +String statut
  }
}

namespace Services {
  class TPEService
  class CommercantService
  class DemandeService
  class AffectationService
  class PanneService
  class TauxService
  class AuthService
  class DashboardService
  class AuditService
  class ScreenService
}

namespace Persistance {
  class TPERepository
  class CommercantRepository
  class DemandeRepository
  class AffectationRepository
  class PanneRepository
  class TauxRepository
  class UserRepository
  class RoleRepository
  class ScreenRepository
  class HistoriqueStatutRepository
  class CommentaireRepository
  class PieceJointeRepository
  class PieceDetacheeRepository
  class AuditLogRepository
}

namespace Securite {
  class SecurityConfig
  class JwtTokenProvider
  class JwtAuthenticationFilter
  class CustomUserDetailsService
  class UserPrincipal
}

namespace Integration {
  class TPEPosting
  class TPEPostingComp
  class TPEPostingService
  class TPEPostingRepository
  class EcritureComptableDTO
}

namespace Frontend {
  class TPEModel <<interface>>
  class CommercantModel <<interface>>
  class DemandeTPEModel <<interface>>
  class PanneModel <<interface>>
  class TauxTPEModel <<interface>>
  class UtilisateurModel <<interface>>
  class DashboardModel <<interface>>
}

