              "raw": "{{baseUrl}}/api/taux/1/soumettre",
              "host": ["{{baseUrl}}"],
              "path": ["api", "taux", "1", "soumettre"]
            }
          }
        },
        {
          "name": "Valider Taux (Authorizer)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"approuver\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/taux/1/valider",
              "host": ["{{baseUrl}}"],
              "path": ["api", "taux", "1", "valider"]
            }
          }
        },
        {
          "name": "Taux en attente",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/taux/en-attente",
              "host": ["{{baseUrl}}"],
              "path": ["api", "taux", "en-attente"]
            }
          }
        }
      ]
    }
  ]
}
