          "name": "Créer Taux (Inputer)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"commercantId\": 1,\n    \"nouveauTauxCommission\": 1.5,\n    \"nouveauTauxCommissionInter\": 0.8,\n    \"commentaire\": \"Nouveau taux commercial\"\n}",
              "options": {
