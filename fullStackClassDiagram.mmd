%% Diagramme de classes de conception - version full-stack
%% Lecture: domaine metier -> securite/persistence -> application -> frontend
%% Vue centrée sur les classes porteuses du domaine et les couches techniques majeures.

namespace DomaineMetier {
  class BaseEntity {
    <<abstract>>
    +Long id
    +LocalDateTime createdDate
    +LocalDateTime lastModifiedDate
    +String createdBy
    +String lastModifiedBy
    +Long version
  }

  class TPE {
    +TypeTPE typeTPE
    +String numeroSerie
    +String numeroTerminal
    +StatutTPE statut
    +String marque
    +String modele
    +LocalDate dateAcquisition
    +LocalDate dateMiseEnService
    +String mcc
    +String numeroAffiliation
    +String cleApi
    +String commentaire
  }

  class Commercant {
    +String raisonSociale
    +String activite
    +String numeroCompte
    +String adresse
    +String localite
    +String codePostal
    +String codeAgence
    +String telephone
    +String email
    +StatutCommercant statut
    +Double loyer
    +String rneFilePath
    +String emailNotification
    +TypeTPE typeCommerce
  }

  class Demande {
    +String reference
    +TypeTPE typeDemande
    +StatutDemande statut
    +Urgence urgence
    +String description
    +String commentaireValidation
    +String numeroTerminal
    +String rneFilePath
    +String urlSiteMarchand
  }

  class Affectation {
    +LocalDate dateAffectation
    +LocalDate dateMiseEnService
    +LocalDate dateFin
    +Boolean actif
    +String bonLivraisonPath
    +String contratPath
    +String commentaire
  }

  class Panne {
    +String reference
    +StatutPanne statut
    +String description
    +LocalDateTime dateDeclaration
    +LocalDateTime dateDiagnostic
    +LocalDateTime dateReparation
    +LocalDateTime dateResolution
    +String diagnostic
    +String actionCorrective
    +Double coutReparation
    +Boolean sousGarantie
  }

  class Taux {
    +Double ancienTauxCommission
    +Double nouveauTauxCommission
    +Double ancienTauxCommissionInter
    +Double nouveauTauxCommissionInter
    +StatutTaux statut
    +LocalDateTime dateSaisie
    +LocalDateTime dateValidation
    +String motifRejet
    +String commentaire
    +LocalDateTime dateApplication
    +Boolean actif
  }

  class User {
    +String username
    +String password
    +String nom
    +String prenom
    +String email
    +String telephone
    +String codeAgence
    +Boolean actif
    +LocalDateTime lastLogin
    +Integer failedLoginAttempts
    +Boolean accountLocked
  }

  class Role {
    +Long id
    +RoleType name
    +String description
  }

  class Screen {
    +String code
    +String libelle
    +String description
    +String route
    +String icon
    +Integer ordre
    +Long parentId
    +Boolean actif
  }

  class ScreenRole {
    +Long id
    +Boolean canView
    +Boolean canCreate
    +Boolean canEdit
    +Boolean canDelete
    +Boolean canExport
    +LocalDateTime createdAt
    +LocalDateTime updatedAt
  }

  class HistoriqueStatut {
    +Long id
    +StatutTPE ancienStatut
    +StatutTPE nouveauStatut
    +LocalDateTime dateChangement
    +String changePar
    +String commentaire
  }

  class Commentaire {
    +String contenu
    +Boolean interne
  }

  class PieceJointe {
    +String nomFichier
    +String cheminFichier
    +String typeMime
    +Long tailleFichier
    +String description
  }

  class PieceDetachee {
    +String designation
    +String reference
    +Integer quantite
    +Double prixUnitaire
    +Double prixTotal
  }

  class TPEImportRecord {
    +String nAffiliation
    +Integer sourceRowNumber
    +String sourceFileName
    +String typeTPE
    +String numeroSerie
    +String numeroTerminal
    +String raisonSociale
    +String activite
    +String mcc
    +String numeroCompte
    +String codeAgence
    +String adresse
    +String codePostal
    +String telephone
    +String email
    +String privilegeSecteur
    +String tauxCommission
    +String tauxCommissionInter
    +String loyer
    +String nCompteIntern
    +String groupe
    +String numSeq
    +Boolean active
    +LocalDate valueDate
    +LocalDate dateAffiliation
    +String rawDataJson
  }

  class AuditLog {
    +LocalDateTime dateAction
    +String username
    +String action
    +String entityType
    +String entityId
    +String details
    +String ipAddress
    +String userAgent
    +String statut
  }
}

