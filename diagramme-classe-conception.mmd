classDiagram
    direction LR

    namespace Domaine {
        class BaseEntity {
            <<abstract>>
            +Long id
            +LocalDateTime createdDate
            +LocalDateTime lastModifiedDate
            +String createdBy
            +String lastModifiedBy
            +Long version
        }

        class Commercant {
            +String raisonSociale
            +String activite
            +String numeroCompte
            +String adresse
            +String localite
            +String codePostal
            +String codeAgence
            +String telephone
            +String email
            +StatutCommercant statut
            +Double loyer
            +TypeTPE typeCommerce
            +String urlSiteMarchand
            +Boolean modeTest
        }

        class Demande {
            +String reference
            +TypeTPE typeDemande
            +StatutDemande statut
            +Urgence urgence
            +String description
            +String commentaireValidation
            +String numeroTerminal
            +String serieTpe
            +String mcc
            +Double tauxCommission
            +Double tauxCommissionInter
            +Double loyer
            +String urlSiteMarchand
        }

        class Affectation {
            +LocalDate dateAffectation
            +LocalDate dateMiseEnService
            +LocalDate dateFin
            +Boolean actif
            +String commentaire
            +String bonLivraisonPath
            +String contratPath
        }

        class TPE {
            +TypeTPE typeTPE
            +String numeroSerie
            +String numeroTerminal
            +StatutTPE statut
            +String marque
            +String modele
            +LocalDate dateAcquisition
            +LocalDate dateMiseEnService
            +String mcc
            +String numeroAffiliation
            +String cleApi
            +String commentaire
        }

        class Panne {
            +String reference
            +StatutPanne statut
            +String description
            +LocalDateTime dateDeclaration
            +LocalDateTime dateDiagnostic
            +LocalDateTime dateReparation
            +LocalDateTime dateResolution
            +String diagnostic
            +String actionCorrective
            +String commentaireTechnicien
            +Double coutReparation
            +Boolean sousGarantie
        }

        class Taux {
            +Double ancienTauxCommission
            +Double nouveauTauxCommission
            +Double ancienTauxCommissionInter
            +Double nouveauTauxCommissionInter
            +StatutTaux statut
            +LocalDateTime dateSaisie
            +LocalDateTime dateValidation
            +LocalDateTime dateApplication
            +Boolean actif
        }

        class User {
            +String username
            +String password
            +String nom
            +String prenom
            +String email
            +String telephone
            +String codeAgence
            +Boolean actif
        }

        class Role {
            +Long id
            +RoleType name
            +String description
        }

        class Screen {
            +String code
            +String libelle
            +String description
            +String route
            +String icon
            +Integer ordre
            +Long parentId
            +Boolean actif
        }

        class ScreenRole {
            +Long id
            +Boolean canView
            +Boolean canCreate
            +Boolean canEdit
            +Boolean canDelete
            +Boolean canExport
            +LocalDateTime createdAt
            +LocalDateTime updatedAt
        }

        class PieceJointe {
            +String nomFichier
            +String cheminFichier
            +String typeMime
            +Long tailleFichier
            +String description
        }

        class Commentaire {
            +String contenu
            +Boolean interne
        }

        class PieceDetachee {
            +String designation
            +String reference
            +Integer quantite
            +Double prixUnitaire
            +Double prixTotal
        }

        class HistoriqueStatut {
            +Long id
            +StatutTPE ancienStatut
            +StatutTPE nouveauStatut
            +LocalDateTime dateChangement
            +String changePar
            +String commentaire
        }

        class AuditLog {
            +Long id
            +LocalDateTime dateAction
            +String username
            +String action
            +String entityType
            +String entityId
            +String details
            +String ipAddress
            +String userAgent
            +String statut
        }
    }

    namespace Services {
        class DemandeService
        class AffectationService
        class TPEService
        class PanneService
        class TauxService
        class CommercantService
        class AuthService
        class DashboardService
        class ScreenService
        class AuditService
    }

    namespace Persistance {
        class DemandeRepository
        class AffectationRepository
        class TPERepository
        class PanneRepository
        class TauxRepository
        class CommercantRepository
        class UserRepository
        class RoleRepository
        class ScreenRepository
        class ScreenRoleRepository
        class PieceJointeRepository
        class CommentaireRepository
        class PieceDetacheeRepository
        class HistoriqueStatutRepository
        class AuditLogRepository
    }

    namespace Securite {
        class SecurityConfig
        class JwtAuthenticationFilter
        class JwtTokenProvider
        class CustomUserDetailsService
        class UserPrincipal
    }

    BaseEntity <|-- Commercant
    BaseEntity <|-- Demande
    BaseEntity <|-- Affectation
    BaseEntity <|-- TPE
    BaseEntity <|-- Panne
    BaseEntity <|-- Taux
    BaseEntity <|-- User
    BaseEntity <|-- Screen
    BaseEntity <|-- PieceJointe
    BaseEntity <|-- Commentaire
    BaseEntity <|-- AuditLog

    Commercant "1" o-- "*" Demande : demandes
    Commercant "1" o-- "*" TPE : tpes
    Commercant "1" o-- "*" Taux : taux
    Commercant "1" o-- "*" Affectation : affectations

    Demande "1" --> "1" Commercant : commercant
    Demande "1" --> "1" User : demandeur
    Demande "0..1" --> "1" User : valideur
    Demande "1" o-- "*" PieceJointe : piecesJointes
    Demande "1" o-- "*" Commentaire : commentaires
    Demande "0..1" -- "1" Affectation : affectation

    Affectation "1" --> "1" TPE : tpe
    Affectation "1" --> "1" Commercant : commercant
    Affectation "0..1" --> "1" Demande : demande
    Affectation "0..1" --> "1" User : affectePar

    TPE "1" --> "0..1" Commercant : commercant
    TPE "1" o-- "*" Affectation : affectations
    TPE "1" o-- "*" Panne : pannes
    TPE "1" o-- "*" HistoriqueStatut : historique

    Panne "1" --> "1" TPE : tpe
    Panne "0..1" --> "1" TPE : tpeRemplacement
    Panne "1" --> "1" User : declarant
    Panne "0..1" --> "1" User : technicien
    Panne "1" o-- "*" PieceDetachee : piecesUtilisees

    Taux "1" --> "1" Commercant : commercant
    Taux "1" --> "1" User : inputer
    Taux "0..1" --> "1" User : authorizer

    User "*" -- "*" Role : roles
    Screen "*" -- "*" Role : droits
    ScreenRole "1" --> "1" Screen : screen
    ScreenRole "1" --> "1" Role : role

    DemandeService --> DemandeRepository
    DemandeService --> CommercantRepository
    DemandeService --> UserRepository
    DemandeService --> AffectationService
    DemandeService --> AuditService

    AffectationService --> AffectationRepository
    AffectationService --> TPERepository
    AffectationService --> DemandeRepository
    AffectationService --> CommercantRepository
    AffectationService --> UserRepository
    AffectationService --> AuditService

    TPEService --> TPERepository
    TPEService --> HistoriqueStatutRepository
    TPEService --> AuditService

    PanneService --> PanneRepository
    PanneService --> TPERepository
    PanneService --> UserRepository

    TauxService --> TauxRepository
    TauxService --> CommercantRepository
    TauxService --> UserRepository

    CommercantService --> CommercantRepository
    AuthService --> CustomUserDetailsService
    DashboardService --> TPERepository
    DashboardService --> DemandeRepository
    ScreenService --> ScreenRepository
    ScreenService --> RoleRepository
    ScreenService --> ScreenRoleRepository
    AuditService --> AuditLogRepository

    SecurityConfig --> JwtAuthenticationFilter
    JwtAuthenticationFilter --> JwtTokenProvider
    CustomUserDetailsService --> UserRepository
    UserPrincipal --> User

