flowchart TB
    subgraph Frontend[Frontend Angular]
        UI[Interface Web]
        FE_SERV[Services Angular
Auth, Demande, TPE, Panne,
Taux, Dashboard]
        FE_SEC[AuthGuard + Interceptor JWT]
    end

    subgraph Backend[Backend Spring Boot]
        CTRL[Controllers REST]
        BIZ[Services metier]
        SEC[Securite JWT + RBAC]
        INT[Integrations
PDF, Excel, Power BI, Fichiers]
    end

    subgraph Domain[Metier]
        D1[Demandes]
        D2[Affectations]
        D3[TPE]
        D4[Commercants]
        D5[Pannes]
        D6[Taux]
        D7[Users / Roles / Ecrans]
    end

    subgraph Persistence[Persistance]
        REPO[JPA Repositories]
        DB[(Base de donnees)]
    end

    UI --> FE_SERV --> FE_SEC --> CTRL
    CTRL --> SEC
    CTRL --> BIZ
    CTRL --> INT
    BIZ --> D1
    BIZ --> D2
    BIZ --> D3
    BIZ --> D4
    BIZ --> D5
    BIZ --> D6
    BIZ --> D7
    D1 --> REPO
    D2 --> REPO
    D3 --> REPO
    D4 --> REPO
    D5 --> REPO
    D6 --> REPO
    D7 --> REPO
    SEC --> REPO
    INT --> REPO
    REPO --> DB

