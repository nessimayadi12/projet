flowchart TB
    subgraph Frontend[Frontend Angular]
        UI[Composants UI
Login, Demandes, TPE, Pannes,
Taux, Dashboard, Sidebar]
        FE_SERV[Services Angular
AuthService, DemandeService,
TPEService, PanneService,
TauxService, ScreenService,
DashboardService, PDFService,
PowerBIService, FileUploadService]
        FE_GUARD[AuthGuard + Permissions Ecran]
        FE_INT[HTTP Interceptor JWT]
    end

    subgraph Backend[Backend Spring Boot]
        CTRL[REST Controllers
Auth, Demande, Affectation,
TPE, Panne, Taux, Screen,
Dashboard, PowerBI, Upload]
        BIZ[Services metier
DemandeService, AffectationService,
TPEService, PanneService,
TauxService, CommercantService,
DashboardService, AuthService,
AuditService, ScreenService]
        SEC[Securite
SecurityConfig, JwtFilter,
JwtTokenProvider, CustomUserDetailsService]
        INT[Integration
TPEPostingService, TPEExcelImportService,
FichierBancaireService, RapportFichierBancaireService,
PowerBIController]
        OBS[Audit + Notification + Fichiers
AuditLog, NotificationService,
FileUploadService]
    end

    subgraph Domain[Modele metier]
        D1[Demandes]
        D2[Affectations]
        D3[TPE]
        D4[Commercants]
        D5[Pannes]
        D6[Taux]
        D7[Utilisateurs / Roles / Ecrans]
    end

    subgraph Persistence[Persistance]
        REPO[JPA Repositories]
        DB[(Base de donnees SQL Server)]
    end

    subgraph External[Systèmes externes]
        FS[(Stockage fichiers
uploads/)]
        PB[Power BI]
    end

    UI --> FE_SERV
    FE_SERV --> FE_INT
    FE_GUARD --> CTRL
    FE_INT --> CTRL

    CTRL --> SEC
    CTRL --> BIZ
    CTRL --> INT
    CTRL --> OBS

    BIZ --> D1
    BIZ --> D2
    BIZ --> D3
    BIZ --> D4
    BIZ --> D5
    BIZ --> D6
    BIZ --> D7

    INT --> D3
    INT --> D4
    INT --> REPO
    OBS --> REPO
    SEC --> REPO

    D1 --> REPO
    D2 --> REPO
    D3 --> REPO
    D4 --> REPO
    D5 --> REPO
    D6 --> REPO
    D7 --> REPO

    REPO --> DB
    OBS -.-> FS
    INT -.-> FS
    INT -.-> PB

    classDef frontend fill:#E3F2FD,stroke:#1E88E5,color:#0D47A1;
    classDef backend fill:#E8F5E9,stroke:#43A047,color:#1B5E20;
    classDef domain fill:#FFF8E1,stroke:#F9A825,color:#E65100;
    classDef persistence fill:#F3E5F5,stroke:#8E24AA,color:#4A148C;
    classDef external fill:#FCE4EC,stroke:#D81B60,color:#880E4F;

    class UI,FE_SERV,FE_GUARD,FE_INT frontend;
    class CTRL,BIZ,SEC,INT,OBS backend;
    class D1,D2,D3,D4,D5,D6,D7 domain;
    class REPO,DB persistence;
    class FS,PB external;
