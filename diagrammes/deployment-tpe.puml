@startuml
' Diagramme de deploiement - Systeme de Gestion du Parc TPE Bancaire
' Version adaptee pour une presentation PFE.

left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam linetype ortho
skinparam node {
  BackgroundColor #F8FAFC
  BorderColor #2563EB
  FontColor #111827
}
skinparam database {
  BackgroundColor #ECFDF5
  BorderColor #0F766E
}
skinparam folder {
  BackgroundColor #FFFBEB
  BorderColor #B45309
}
skinparam cloud {
  BackgroundColor #EFF6FF
  BorderColor #2563EB
}

actor "Administrateur" as Admin
actor "Service\nMonetique" as Monetique
actor "Agence\nbancaire" as Agence

node "Poste utilisateur" as Client {
  artifact "Navigateur Web" as Browser
  artifact "Application Angular\nSPA" as AngularApp
  artifact "LocalStorage\nJWT token" as LocalStorage
}

node "Serveur Web / Frontend" as WebServer {
  artifact "Build Angular\nHTML / CSS / JS" as AngularBuild
  artifact "Assets statiques" as Assets
}

node "Serveur Applicatif" as AppServer {
  artifact "tpe-management.jar\nSpring Boot 3 / Java 17" as SpringApp
  artifact "API REST\n/api/**" as RestApi
  artifact "Spring Security\nJWT Filter" as JwtSecurity
  artifact "Services metier" as BusinessLayer
  artifact "Repositories JPA" as JpaLayer
}

database "Serveur Base de Donnees\nMicrosoft SQL Server\nTPE_Managements" as SqlServer {
  artifact "Tables metier\nusers, roles, tpes,\ncommercants, demandes,\naffectations, pannes, taux" as TablesMetier
  artifact "Tables techniques\nscreen_roles, audit_logs,\nTPE_POSTING_comp" as TablesTech
}

folder "Stockage fichiers\n./uploads" as Uploads {
  artifact "Pieces jointes demandes" as PJ
  artifact "Contrats et bons\nde livraison" as DocsMetier
  artifact "Rapports PDF / texte" as Reports
}

folder "Journalisation\nlogs/" as LogFolder {
  artifact "tpe-management.log" as AppLog
}

cloud "Power BI Service\noptionnel" as PowerBI {
  artifact "Rapports embarques" as PowerBIReports
}

artifact "Fichiers Excel / CSV\nImport parc TPE" as ExcelImport
artifact "Fichier bancaire\ntransactions" as BankFile

Admin --> Browser
Monetique --> Browser
Agence --> Browser

Browser --> WebServer : HTTP/HTTPS\nchargement application
Browser --> RestApi : HTTP/HTTPS REST\nBearer JWT
AngularApp --> LocalStorage : stocke token
AngularBuild --> AngularApp : execute dans navigateur

RestApi --> JwtSecurity : authentification\nautorisation
JwtSecurity --> BusinessLayer : utilisateur authentifie
BusinessLayer --> JpaLayer : acces donnees
JpaLayer --> SqlServer : JDBC / Hibernate

BusinessLayer --> Uploads : lecture / ecriture\nfichiers metier
BusinessLayer --> LogFolder : logs techniques
RestApi ..> PowerBI : token / embed URL

ExcelImport --> Browser : selection fichier
Browser --> RestApi : upload multipart
BankFile --> Browser : selection fichier
Browser --> RestApi : upload transactions

note right of AppServer
  Le backend expose les endpoints REST,
  applique la securite JWT et orchestre
  les services metier.
end note

note bottom of SqlServer
  Base cible du systeme:
  Microsoft SQL Server.
end note

@enduml
