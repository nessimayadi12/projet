@startuml
' Diagramme de classes d'analyse - Systeme de Gestion du Parc TPE Bancaire
' Genere depuis les entites backend Spring Boot, les services metier et les modeles Angular.

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam class {
  BackgroundColor #F8FAFC
  BorderColor #2563EB
  FontColor #111827
}
skinparam package {
  BorderColor #0F766E
  FontColor #111827
}

hide empty members

package "Interfaces utilisateur <<boundary>>" {
  class AuthUI <<boundary>>
  class DashboardUI <<boundary>>
  class AdministrationUI <<boundary>>
  class CommercantUI <<boundary>>
  class TPEUI <<boundary>>
  class DemandeUI <<boundary>>
  class TauxUI <<boundary>>
  class MaintenanceUI <<boundary>>
  class ImportBancaireUI <<boundary>>
}

package "Traitements metier <<control>>" {
  class AuthControl <<control>> {
    +authentifier()
    +creerUtilisateur()
  }

  class PermissionControl <<control>> {
    +chargerEcransUtilisateur()
    +attribuerPermissions()
  }

  class DashboardControl <<control>> {
    +calculerStatistiques()
    +genererIndicateurs()
  }

  class CommercantControl <<control>> {
    +creerCommercant()
    +modifierCommercant()
    +changerStatut()
  }

  class TPEControl <<control>> {
    +creerTPE()
    +importerParcTPE()
    +genererTID()
    +changerStatut()
  }

  class DemandeControl <<control>> {
    +creerDemande()
    +saisirDonneesMonetiques()
    +validerOuRejeter()
    +cloturerDemande()
  }

  class AffectationControl <<control>> {
    +affecterTPE()
    +mettreEnService()
    +desaffecterTPE()
  }

  class TauxControl <<control>> {
    +saisirTaux()
    +soumettreValidation()
    +validerOuRejeter()
  }

  class PanneControl <<control>> {
    +declarerPanne()
    +diagnostiquer()
    +reparer()
    +tester()
  }

  class ImportBancaireControl <<control>> {
    +importerFichier()
    +verifierTPE()
    +verifierPorteur()
    +insererEcritures()
  }

  class AuditControl <<control>> {
    +journaliserAction()
  }
}

package "Objets metier <<entity>>" {
  abstract class BaseEntity <<entity>> {
    id: Long
    createdDate: DateTime
    lastModifiedDate: DateTime
    createdBy: String
    lastModifiedBy: String
    version: Long
  }

  class Utilisateur <<entity>> {
    username: String
    nom: String
    prenom: String
    email: String
    codeAgence: String
    actif: Boolean
  }

  class Role <<entity>> {
    name: RoleType
    description: String
  }

  class Ecran <<entity>> {
    code: String
    libelle: String
    route: String
    actif: Boolean
  }

  class PermissionEcran <<entity>> {
    canView: Boolean
    canCreate: Boolean
    canEdit: Boolean
    canDelete: Boolean
    canExport: Boolean
  }

  class Commercant <<entity>> {
    raisonSociale: String
    activite: String
    numeroCompte: String
    codeAgence: String
    email: String
    statut: StatutCommercant
    typeCommerce: TypeTPE
    urlSiteMarchand: String
  }

  class TPE <<entity>> {
    typeTPE: TypeTPE
    numeroSerie: String
    numeroTerminal: String
    statut: StatutTPE
    marque: String
    modele: String
    mcc: String
    numeroAffiliation: String
  }

  class DemandeTPE <<entity>> {
    reference: String
    typeDemande: TypeTPE
    statut: StatutDemande
    urgence: Urgence
    description: String
    numeroTerminal: String
    commentaireValidation: String
  }

  class Affectation <<entity>> {
    dateAffectation: Date
    dateMiseEnService: Date
    dateFin: Date
    actif: Boolean
    bonLivraisonPath: String
    contratPath: String
  }

  class TauxTPE <<entity>> {
    ancienTauxCommission: Double
    nouveauTauxCommission: Double
    ancienTauxCommissionInter: Double
    nouveauTauxCommissionInter: Double
    statut: StatutTaux
    actif: Boolean
  }

  class Panne <<entity>> {
    reference: String
    statut: StatutPanne
    description: String
    diagnostic: String
    actionCorrective: String
    coutReparation: Double
  }

  class PieceJointe <<entity>> {
    nomFichier: String
    cheminFichier: String
    typeMime: String
    tailleFichier: Long
  }

  class Commentaire <<entity>> {
    contenu: String
    interne: Boolean
  }

  class PieceDetachee <<entity>> {
    designation: String
    reference: String
    quantite: Integer
    prixTotal: Double
  }

  class HistoriqueStatut <<entity>> {
    ancienStatut: StatutTPE
    nouveauStatut: StatutTPE
    dateChangement: DateTime
    changePar: String
  }

  class LigneImportTPE <<entity>> {
    nAffiliation: String
    sourceFileName: String
    numeroSerie: String
    numeroTerminal: String
    rawDataJson: Text
  }

  class TransactionBancaire <<entity>> {
    branch: String
    account: String
    ref: String
    tranType: String
    amount: Decimal
    sessionDate: String
  }

  class AuditLog <<entity>> {
    dateAction: DateTime
    username: String
    action: String
    entityType: String
    entityId: String
    statut: String
  }
}

package "Enumerations metier" {
  enum RoleType {
    ROLE_ADMIN
    ROLE_MONETIQUE
    ROLE_AGENCE
    ROLE_INPUTER
    ROLE_AUTHORIZER
  }

  enum TypeTPE {
    TPE
    MOBILE
  }

  enum StatutTPE {
    DISPONIBLE
    RESERVE
    AFFECTE
    EN_PANNE
    MAINTENANCE
    HORS_SERVICE
  }

  enum StatutDemande {
    NOUVELLE
    EN_COURS
    VALIDEE_MONETIQUE
    AFFECTEE
    CLOTUREE
    REJETEE
  }

  enum StatutPanne {
    DECLAREE
    DIAGNOSTIQUEE
    EN_REPARATION
    REPAREE
    TESTEE
    IRRECUPERABLE
  }

  enum StatutTaux {
    BROUILLON
    EN_ATTENTE_VALIDATION
    VALIDE
    REJETE
  }

  enum StatutCommercant {
    ACTIF
    INACTIF
    SUSPENDU
  }

  enum Urgence {
    BASSE
    NORMALE
    HAUTE
    CRITIQUE
  }
}

BaseEntity <|-- Utilisateur
BaseEntity <|-- Commercant
BaseEntity <|-- TPE
BaseEntity <|-- DemandeTPE
BaseEntity <|-- Affectation
BaseEntity <|-- TauxTPE
BaseEntity <|-- Panne
BaseEntity <|-- PieceJointe
BaseEntity <|-- Commentaire
BaseEntity <|-- Ecran
BaseEntity <|-- LigneImportTPE
BaseEntity <|-- TransactionBancaire

Utilisateur "0..*" -- "0..*" Role : possede >
Role "1" -- "0..*" PermissionEcran : definit >
Ecran "1" -- "0..*" PermissionEcran : protege >

Commercant "1" -- "0..*" TPE : possede >
Commercant "1" -- "0..*" DemandeTPE : concerne >
Commercant "1" -- "0..*" TauxTPE : taux >
Commercant "1" -- "0..*" Affectation : recoit >

TPE "1" -- "0..*" Affectation : historique >
TPE "1" -- "0..*" Panne : subit >
TPE "1" -- "0..*" HistoriqueStatut : trace >
Panne "0..1" --> "0..1" TPE : remplacement >

DemandeTPE "0..1" -- "0..1" Affectation : declenche >
DemandeTPE "1" -- "0..*" PieceJointe : contient >
DemandeTPE "1" -- "0..*" Commentaire : discute >
Panne "1" -- "0..*" PieceDetachee : utilise >

Utilisateur "1" -- "0..*" DemandeTPE : demandeur >
Utilisateur "0..1" -- "0..*" DemandeTPE : inputer/valideur >
Utilisateur "1" -- "0..*" TauxTPE : saisit >
Utilisateur "0..1" -- "0..*" TauxTPE : valide >
Utilisateur "0..1" -- "0..*" Affectation : affecte >
Utilisateur "1" -- "0..*" Panne : declare >
Utilisateur "0..1" -- "0..*" Panne : traite >
Utilisateur ..> AuditLog : genere

Role --> RoleType
Commercant --> StatutCommercant
Commercant --> TypeTPE
TPE --> TypeTPE
TPE --> StatutTPE
DemandeTPE --> TypeTPE
DemandeTPE --> StatutDemande
DemandeTPE --> Urgence
TauxTPE --> StatutTaux
Panne --> StatutPanne
HistoriqueStatut --> StatutTPE

AuthUI --> AuthControl
DashboardUI --> DashboardControl
AdministrationUI --> PermissionControl
CommercantUI --> CommercantControl
TPEUI --> TPEControl
DemandeUI --> DemandeControl
DemandeUI --> AffectationControl
TauxUI --> TauxControl
MaintenanceUI --> PanneControl
ImportBancaireUI --> ImportBancaireControl

AuthControl --> Utilisateur
AuthControl --> Role
PermissionControl --> Ecran
PermissionControl --> PermissionEcran
PermissionControl --> Role
DashboardControl --> TPE
DashboardControl --> DemandeTPE
DashboardControl --> Panne
CommercantControl --> Commercant
TPEControl --> TPE
TPEControl --> LigneImportTPE
TPEControl --> HistoriqueStatut
DemandeControl --> DemandeTPE
DemandeControl --> PieceJointe
DemandeControl --> Commentaire
AffectationControl --> Affectation
AffectationControl --> TPE
TauxControl --> TauxTPE
PanneControl --> Panne
PanneControl --> PieceDetachee
ImportBancaireControl --> TransactionBancaire
ImportBancaireControl --> TPE

AuthControl ..> AuditControl
CommercantControl ..> AuditControl
TPEControl ..> AuditControl
DemandeControl ..> AuditControl
AffectationControl ..> AuditControl
TauxControl ..> AuditControl
PanneControl ..> AuditControl
AuditControl --> AuditLog

note right of TauxControl
  Regle 4 yeux:
  l'Inputer saisit et soumet,
  l'Authorizer valide ou rejette.
end note

note bottom of DemandeTPE
  Workflow:
  NOUVELLE -> EN_COURS
  -> VALIDEE_MONETIQUE
  -> AFFECTEE -> CLOTUREE
  ou REJETEE.
end note

@enduml
