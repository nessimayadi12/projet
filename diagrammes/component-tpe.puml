@startuml
' Diagramme de composants - Systeme de Gestion du Parc TPE Bancaire
' Genere depuis l'architecture Angular + Spring Boot observee dans le projet.

left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam component {
  BackgroundColor #F8FAFC
  BorderColor #2563EB
  FontColor #111827
}
skinparam database {
  BackgroundColor #ECFDF5
  BorderColor #0F766E
}
skinparam folder {
  BackgroundColor #FFFBEB
  BorderColor #B45309
}
skinparam cloud {
  BackgroundColor #EFF6FF
  BorderColor #2563EB
}

actor "Administrateur" as Admin
actor "Service\nMonetique" as Monetique
actor "Agence\nbancaire" as Agence

node "Navigateur Web" {
  package "Application Angular" as Angular {
    [AppModule]
    [AppRoutingModule]
    [AdminLayoutModule]
    [ComponentsModule\nNavbar / Sidebar / Footer]
    [AuthGuard]
    [AuthInterceptor]
  }

  package "Modules fonctionnels Angular" {
    [Login / Register] as LoginUI
    [Dashboard] as DashboardUI
    [Gestion TPE] as TPEUI
    [Gestion Commercants] as CommercantUI
    [Demandes TPE] as DemandeUI
    [Gestion Taux] as TauxUI
    [Maintenance / Pannes] as MaintenanceUI
    [Upload Transactions] as UploadUI
    [Gestion Permissions] as PermissionUI
    [Power BI Report] as PowerBIUI
  }

  package "Services Angular" {
    [AuthService]
    [ScreenService]
    [DashboardService]
    [TpeService]
    [CommercantService]
    [DemandeService]
    [TauxTpeService]
    [PanneService]
    [FileUploadService]
    [TpePostingService]
    [PowerBIService]
    [PdfService]
    [ExcelExportService]
  }
}

node "Serveur Applicatif Spring Boot\nJava 17 / Spring Boot 3" {
  package "API REST Controllers" as Controllers {
    [AuthController]
    [DashboardController]
    [TPEController]
    [CommercantController]
    [DemandeController]
    [AffectationController]
    [TauxController]
    [PanneController]
    [FileUploadController]
    [FichierBancaireController]
    [TPEPostingController]
    [ScreenController]
    [RoleController]
    [PowerBIController]
  }

  package "Securite" as Security {
    [SecurityConfig]
    [JwtAuthenticationFilter]
    [JwtTokenProvider]
    [CustomUserDetailsService]
  }

  package "Services metier" as BusinessServices {
    [AuthService\nbackend] as BAuthService
    [DashboardService\nbackend] as BDashboardService
    [TPEService]
    [CommercantService\nbackend] as BCommercantService
    [DemandeService\nbackend] as BDemandeService
    [AffectationService]
    [TauxService]
    [PanneService\nbackend] as BPanneService
    [ScreenService\nbackend] as BScreenService
    [FileUploadService\nbackend] as BFileUploadService
    [FichierBancaireService]
    [TPEPostingService]
    [AuditService]
  }

  package "Couche persistance" as Persistence {
    [Repositories Spring Data JPA]
    [Entites JPA]
    [DTO / ModelMapper]
  }

  package "Generation documents" as Documents {
    [PDF / iText]
    [Excel / Apache POI]
  }

  component "Documentation API" as ApiDocs {
    [Swagger / OpenAPI]
  }
}

database "Base de donnees\nSQL Server\nTPE_Managements" as DB
folder "Stockage fichiers\n./uploads" as Uploads
folder "Logs application\nlogs/tpe-management.log" as Logs
cloud "Power BI Service\n(optionnel)" as PowerBI
artifact "Fichiers Excel / CSV\nImport parc TPE" as ExcelFiles
artifact "Fichier bancaire\ntransactions" as BankFile

Admin --> Angular
Monetique --> Angular
Agence --> Angular

AppModule --> AppRoutingModule
AppModule --> AdminLayoutModule
AppModule --> ComponentsModule
AppModule --> AuthInterceptor
AppRoutingModule --> AuthGuard
AdminLayoutModule --> DashboardUI
AdminLayoutModule --> TPEUI
AdminLayoutModule --> CommercantUI
AdminLayoutModule --> DemandeUI
AdminLayoutModule --> MaintenanceUI
AdminLayoutModule --> PermissionUI

LoginUI --> AuthService
DashboardUI --> DashboardService
TPEUI --> TpeService
TPEUI --> TauxTpeService
CommercantUI --> CommercantService
DemandeUI --> DemandeService
DemandeUI --> PdfService
MaintenanceUI --> PanneService
UploadUI --> FileUploadService
UploadUI --> TpePostingService
PermissionUI --> ScreenService
PowerBIUI --> PowerBIService

AuthInterceptor --> Controllers : HTTPS/HTTP REST\nAuthorization Bearer JWT
AuthGuard --> ScreenService

AuthService --> AuthController
ScreenService --> ScreenController
DashboardService --> DashboardController
TpeService --> TPEController
CommercantService --> CommercantController
DemandeService --> DemandeController
DemandeService --> AffectationController
TauxTpeService --> TauxController
PanneService --> PanneController
FileUploadService --> FileUploadController
TpePostingService --> FichierBancaireController
TpePostingService --> TPEPostingController
PowerBIService --> PowerBIController

Controllers --> Security : routes protegees
Security --> BAuthService
Security --> CustomUserDetailsService
Controllers --> BusinessServices
BusinessServices --> Persistence
BusinessServices --> Documents
BusinessServices --> AuditService

Persistence --> DB : JPA / Hibernate
Documents --> Uploads : contrats,\nbons, rapports
BFileUploadService --> Uploads : upload pieces jointes
BDemandeService --> Uploads : pieces demande
TPEPostingService --> Persistence : ecritures comptables
FichierBancaireService --> Persistence
FichierBancaireService --> Documents
PowerBIController --> PowerBI : embed URL / token
AuditService --> Logs
ApiDocs --> Controllers

ExcelFiles --> TPEUI
ExcelFiles --> TPEController
BankFile --> UploadUI
BankFile --> FichierBancaireController

note right of Security
  JWT stateless:
  login public, routes metier protegees
  par roles et permissions d'ecrans.
end note

note bottom of DB
  Base cible du systeme:
  Microsoft SQL Server.
  Acces via Spring Data JPA / Hibernate.
end note

@enduml
