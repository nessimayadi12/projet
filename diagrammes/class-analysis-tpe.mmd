%% Diagramme de classes d'analyse - Systeme de Gestion du Parc TPE Bancaire
%% Version Mermaid simplifiee pour previsualisation rapide.

classDiagram
direction LR

class AuthUI {
  <<boundary>>
}
class DashboardUI {
  <<boundary>>
}
class AdministrationUI {
  <<boundary>>
}
class CommercantUI {
  <<boundary>>
}
class TPEUI {
  <<boundary>>
}
class DemandeUI {
  <<boundary>>
}
class TauxUI {
  <<boundary>>
}
class MaintenanceUI {
  <<boundary>>
}
class ImportBancaireUI {
  <<boundary>>
}

class AuthControl {
  <<control>>
  +authentifier()
  +creerUtilisateur()
}
class PermissionControl {
  <<control>>
  +chargerEcransUtilisateur()
  +attribuerPermissions()
}
class DashboardControl {
  <<control>>
  +calculerStatistiques()
}
class CommercantControl {
  <<control>>
  +creerCommercant()
  +modifierCommercant()
}
class TPEControl {
  <<control>>
  +creerTPE()
  +importerParcTPE()
  +genererTID()
}
class DemandeControl {
  <<control>>
  +creerDemande()
  +saisirDonneesMonetiques()
  +validerOuRejeter()
}
class AffectationControl {
  <<control>>
  +affecterTPE()
  +mettreEnService()
}
class TauxControl {
  <<control>>
  +saisirTaux()
  +soumettreValidation()
  +validerOuRejeter()
}
class PanneControl {
  <<control>>
  +declarerPanne()
  +diagnostiquer()
  +reparer()
}
class ImportBancaireControl {
  <<control>>
  +importerFichier()
  +insererEcritures()
}
class AuditControl {
  <<control>>
  +journaliserAction()
}

class BaseEntity {
  <<entity>>
  id: Long
  createdDate: DateTime
  lastModifiedDate: DateTime
}
class Utilisateur {
  <<entity>>
  username: String
  nom: String
  prenom: String
  email: String
  codeAgence: String
  actif: Boolean
}
class Role {
  <<entity>>
  name: RoleType
  description: String
}
class Ecran {
  <<entity>>
  code: String
  libelle: String
  route: String
  actif: Boolean
}
class PermissionEcran {
  <<entity>>
  canView: Boolean
  canCreate: Boolean
  canEdit: Boolean
  canDelete: Boolean
  canExport: Boolean
}
class Commercant {
  <<entity>>
  raisonSociale: String
  activite: String
  numeroCompte: String
  codeAgence: String
  statut: StatutCommercant
  typeCommerce: TypeTPE
}
class TPE {
  <<entity>>
  typeTPE: TypeTPE
  numeroSerie: String
  numeroTerminal: String
  statut: StatutTPE
  marque: String
  modele: String
}
class DemandeTPE {
  <<entity>>
  reference: String
  typeDemande: TypeTPE
  statut: StatutDemande
  urgence: Urgence
  description: String
}
class Affectation {
  <<entity>>
  dateAffectation: Date
  dateMiseEnService: Date
  actif: Boolean
}
class TauxTPE {
  <<entity>>
  ancienTauxCommission: Double
  nouveauTauxCommission: Double
  statut: StatutTaux
  actif: Boolean
}
class Panne {
  <<entity>>
  reference: String
  statut: StatutPanne
  description: String
  diagnostic: String
}
class PieceJointe {
  <<entity>>
  nomFichier: String
  cheminFichier: String
}
class Commentaire {
  <<entity>>
  contenu: String
  interne: Boolean
}
class PieceDetachee {
  <<entity>>
  designation: String
  quantite: Integer
}
class HistoriqueStatut {
  <<entity>>
  ancienStatut: StatutTPE
  nouveauStatut: StatutTPE
  dateChangement: DateTime
}
class LigneImportTPE {
  <<entity>>
  nAffiliation: String
  sourceFileName: String
  rawDataJson: Text
}
class TransactionBancaire {
  <<entity>>
  account: String
  ref: String
  amount: Decimal
  sessionDate: String
}
class AuditLog {
  <<entity>>
  dateAction: DateTime
  username: String
  action: String
  entityType: String
}

class RoleType {
  <<enumeration>>
  ROLE_ADMIN
  ROLE_MONETIQUE
  ROLE_AGENCE
  ROLE_INPUTER
  ROLE_AUTHORIZER
}
class TypeTPE {
  <<enumeration>>
  TPE
  MOBILE
}
class StatutTPE {
  <<enumeration>>
  DISPONIBLE
  RESERVE
  AFFECTE
  EN_PANNE
  MAINTENANCE
  HORS_SERVICE
}
class StatutDemande {
  <<enumeration>>
  NOUVELLE
  EN_COURS
  VALIDEE_MONETIQUE
  AFFECTEE
  CLOTUREE
  REJETEE
}
class StatutPanne {
  <<enumeration>>
  DECLAREE
  DIAGNOSTIQUEE
  EN_REPARATION
  REPAREE
  TESTEE
  IRRECUPERABLE
}
class StatutTaux {
  <<enumeration>>
  BROUILLON
  EN_ATTENTE_VALIDATION
  VALIDE
  REJETE
}
class StatutCommercant {
  <<enumeration>>
  ACTIF
  INACTIF
  SUSPENDU
}
class Urgence {
  <<enumeration>>
  BASSE
  NORMALE
  HAUTE
  CRITIQUE
}

BaseEntity <|-- Utilisateur
BaseEntity <|-- Commercant
BaseEntity <|-- TPE
BaseEntity <|-- DemandeTPE
BaseEntity <|-- Affectation
BaseEntity <|-- TauxTPE
BaseEntity <|-- Panne
BaseEntity <|-- PieceJointe
BaseEntity <|-- Commentaire
BaseEntity <|-- Ecran
BaseEntity <|-- LigneImportTPE
BaseEntity <|-- TransactionBancaire

Utilisateur "0..*" -- "0..*" Role : possede
Role "1" -- "0..*" PermissionEcran : definit
Ecran "1" -- "0..*" PermissionEcran : protege

Commercant "1" -- "0..*" TPE : possede
Commercant "1" -- "0..*" DemandeTPE : concerne
Commercant "1" -- "0..*" TauxTPE : taux
Commercant "1" -- "0..*" Affectation : recoit
TPE "1" -- "0..*" Affectation : historique
TPE "1" -- "0..*" Panne : subit
TPE "1" -- "0..*" HistoriqueStatut : trace
Panne "0..1" --> "0..1" TPE : remplacement
DemandeTPE "0..1" -- "0..1" Affectation : declenche
DemandeTPE "1" -- "0..*" PieceJointe : contient
DemandeTPE "1" -- "0..*" Commentaire : discute
Panne "1" -- "0..*" PieceDetachee : utilise

Utilisateur "1" -- "0..*" DemandeTPE : demandeur
Utilisateur "0..1" -- "0..*" DemandeTPE : inputer/valideur
Utilisateur "1" -- "0..*" TauxTPE : saisit
Utilisateur "0..1" -- "0..*" TauxTPE : valide
Utilisateur "0..1" -- "0..*" Affectation : affecte
Utilisateur "1" -- "0..*" Panne : declare
Utilisateur "0..1" -- "0..*" Panne : traite
Utilisateur ..> AuditLog : genere

Role --> RoleType
Commercant --> StatutCommercant
Commercant --> TypeTPE
TPE --> TypeTPE
TPE --> StatutTPE
DemandeTPE --> TypeTPE
DemandeTPE --> StatutDemande
DemandeTPE --> Urgence
TauxTPE --> StatutTaux
Panne --> StatutPanne
HistoriqueStatut --> StatutTPE

AuthUI --> AuthControl
DashboardUI --> DashboardControl
AdministrationUI --> PermissionControl
CommercantUI --> CommercantControl
TPEUI --> TPEControl
DemandeUI --> DemandeControl
DemandeUI --> AffectationControl
TauxUI --> TauxControl
MaintenanceUI --> PanneControl
ImportBancaireUI --> ImportBancaireControl

AuthControl --> Utilisateur
AuthControl --> Role
PermissionControl --> Ecran
PermissionControl --> PermissionEcran
DashboardControl --> TPE
DashboardControl --> DemandeTPE
DashboardControl --> Panne
CommercantControl --> Commercant
TPEControl --> TPE
TPEControl --> LigneImportTPE
DemandeControl --> DemandeTPE
AffectationControl --> Affectation
TauxControl --> TauxTPE
PanneControl --> Panne
ImportBancaireControl --> TransactionBancaire
AuditControl --> AuditLog
