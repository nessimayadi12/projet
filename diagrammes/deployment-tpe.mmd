%% Diagramme de deploiement - Systeme de Gestion du Parc TPE Bancaire
%% Version Mermaid simplifiee pour previsualisation rapide.

flowchart LR
  Admin["Administrateur"]
  Monetique["Service<br/>Monetique"]
  Agence["Agence<br/>bancaire"]

  subgraph Client["Poste utilisateur"]
    Browser["Navigateur Web"]
    AngularApp["Application Angular<br/>SPA"]
    LocalStorage["LocalStorage<br/>JWT token"]
  end

  subgraph WebServer["Serveur Web / Frontend"]
    AngularBuild["Build Angular<br/>HTML / CSS / JS"]
    Assets["Assets statiques"]
  end

  subgraph AppServer["Serveur Applicatif"]
    SpringApp["tpe-management.jar<br/>Spring Boot 3 / Java 17"]
    RestApi["API REST<br/>/api/**"]
    JwtSecurity["Spring Security<br/>JWT Filter"]
    BusinessLayer["Services metier"]
    JpaLayer["Repositories JPA"]
  end

  subgraph SqlServer["Serveur Base de Donnees<br/>Microsoft SQL Server<br/>TPE_Managements"]
    TablesMetier["Tables metier<br/>users, roles, tpes,<br/>commercants, demandes,<br/>affectations, pannes, taux"]
    TablesTech["Tables techniques<br/>screen_roles, audit_logs,<br/>TPE_POSTING_comp"]
  end

  subgraph Uploads["Stockage fichiers<br/>./uploads"]
    PJ["Pieces jointes demandes"]
    DocsMetier["Contrats et bons<br/>de livraison"]
    Reports["Rapports PDF / texte"]
  end

  subgraph Logs["Journalisation<br/>logs/"]
    AppLog["tpe-management.log"]
  end

  PowerBI[("Power BI Service<br/>optionnel")]
  ExcelImport["Fichiers Excel / CSV<br/>Import parc TPE"]
  BankFile["Fichier bancaire<br/>transactions"]

  Admin --> Browser
  Monetique --> Browser
  Agence --> Browser

  Browser -->|"HTTP/HTTPS<br/>chargement application"| WebServer
  Browser -->|"HTTP/HTTPS REST<br/>Bearer JWT"| RestApi
  AngularApp -->|"stocke token"| LocalStorage
  AngularBuild -->|"execute dans navigateur"| AngularApp

  RestApi -->|"authentification<br/>autorisation"| JwtSecurity
  JwtSecurity -->|"utilisateur authentifie"| BusinessLayer
  BusinessLayer -->|"acces donnees"| JpaLayer
  JpaLayer -->|"JDBC / Hibernate"| SqlServer

  BusinessLayer -->|"lecture / ecriture<br/>fichiers metier"| Uploads
  BusinessLayer -->|"logs techniques"| Logs
  RestApi -.->|"token / embed URL"| PowerBI

  ExcelImport -->|"selection fichier"| Browser
  BankFile -->|"selection fichier"| Browser
  Browser -->|"upload multipart"| RestApi

  classDef actor fill:#FFFFFF,stroke:#111827,color:#111827;
  classDef node fill:#F8FAFC,stroke:#2563EB,color:#111827;
  classDef data fill:#ECFDF5,stroke:#0F766E,color:#111827;
  classDef external fill:#FFFBEB,stroke:#B45309,color:#111827;
  class Admin,Monetique,Agence actor;
  class Browser,AngularApp,LocalStorage,AngularBuild,Assets,SpringApp,RestApi,JwtSecurity,BusinessLayer,JpaLayer node;
  class TablesMetier,TablesTech,PJ,DocsMetier,Reports,AppLog data;
  class PowerBI,ExcelImport,BankFile external;
