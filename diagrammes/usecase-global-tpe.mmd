%% Diagramme de cas d'utilisation global - Systeme de Gestion du Parc TPE Bancaire
%% Version Mermaid d'accompagnement. La version UML de reference est usecase-global-tpe.puml.
%% Sources: backend Spring Boot, frontend Angular, SecurityConfig, DataInitializer, workflows metier.

flowchart LR
  User["Utilisateur<br/>authentifie"]
  Admin["Administrateur"]
  Monetique["Service<br/>Monetique"]
  Agence["Agence<br/>bancaire"]
  Inputer["Inputer<br/>(Monetique)"]
  Authorizer["Authorizer<br/>(Monetique)"]
  PowerBI["Microsoft<br/>Power BI"]
  BankFlow["Flux bancaire<br/>TXT"]

  Admin -. specialise .-> User
  Monetique -. specialise .-> User
  Agence -. specialise .-> User
  Inputer -. sous-role .-> Monetique
  Authorizer -. sous-role .-> Monetique

  subgraph System["Systeme de Gestion du Parc TPE Bancaire"]
    direction LR

    subgraph Access["Securite et administration"]
      UC_AUTH(["Se connecter<br/>(JWT)"])
      UC_PROFILE(["Consulter son<br/>profil"])
      UC_USERS(["Gerer utilisateurs"])
      UC_PERMISSIONS(["Gerer ecrans,<br/>roles et permissions"])
      UC_ACCESS(["Controler acces<br/>screenCode + droits"])
    end

    subgraph Reporting["Pilotage et reporting"]
      UC_DASHBOARD(["Consulter tableaux<br/>de bord"])
      UC_ANALYTICS(["Analyser indicateurs<br/>TPE, demandes,<br/>pannes, commercants"])
      UC_EXPORT(["Exporter listes<br/>Excel / PDF"])
      UC_POWERBI(["Consulter rapports<br/>Power BI"])
    end

    subgraph Referentiel["Referentiel TPE et commercants"]
      UC_TPE_VIEW(["Consulter parc TPE"])
      UC_TPE_MANAGE(["Creer, modifier,<br/>supprimer TPE"])
      UC_TPE_STATUS(["Changer statut TPE"])
      UC_TPE_IMPORT(["Importer parc TPE<br/>Excel"])
      UC_TPE_IMPORT_RECORDS(["Consulter lignes<br/>d'import TPE"])
      UC_TID(["Generer numero<br/>terminal TID"])
      UC_MERCHANT_VIEW(["Consulter<br/>commercants"])
      UC_MERCHANT_MANAGE(["Creer, modifier,<br/>supprimer commercant"])
      UC_MERCHANT_STATUS(["Activer / desactiver<br/>commercant"])
    end

    subgraph Requests["Demandes TPE et affectations"]
      UC_REQUEST_CREATE(["Creer demande TPE"])
      UC_REQUEST_FOLLOW(["Consulter, modifier<br/>et imprimer demande"])
      UC_ATTACH(["Joindre / telecharger<br/>piece justificative"])
      UC_RESOLVE_MERCHANT(["Identifier ou creer<br/>commercant"])
      UC_REQUEST_INPUT(["Saisir donnees<br/>monetiques"])
      UC_REQUEST_AUTHORIZE(["Valider ou rejeter<br/>demande"])
      UC_AFFECT(["Affecter TPE<br/>au commercant"])
      UC_SERVICE(["Mettre en service<br/>ou desaffecter TPE"])
      UC_CLOSE_REQUEST(["Cloturer demande"])
    end

    subgraph Rates["Taux TPE - controle 4 yeux"]
      UC_RATE_INPUT(["Saisir taux<br/>commercant"])
      UC_RATE_SUBMIT(["Soumettre taux<br/>a validation"])
      UC_RATE_AUTHORIZE(["Valider ou rejeter<br/>taux"])
      UC_RATE_VIEW(["Consulter taux<br/>par commercant"])
      UC_FOUR_EYES(["Controler regle<br/>Inputer != Authorizer"])
    end

    subgraph Maintenance["Maintenance TPE"]
      UC_FAILURE_DECLARE(["Declarer panne TPE"])
      UC_FAILURE_VIEW(["Consulter et filtrer<br/>pannes"])
      UC_FAILURE_ASSIGN(["Assigner technicien"])
      UC_FAILURE_REPAIR(["Diagnostiquer,<br/>reparer et tester"])
      UC_FAILURE_REPLACE(["Affecter TPE<br/>de remplacement"])
      UC_FAILURE_EXPORT(["Exporter rapport<br/>pannes"])
    end

    subgraph Banking["Transactions bancaires"]
      UC_BANK_IMPORT(["Importer fichier<br/>bancaire TXT"])
      UC_BANK_PROCESS(["Traiter transactions<br/>Type 10 / Type 20"])
      UC_BANK_VERIFY(["Verifier TPE et<br/>commercant affecte"])
      UC_BANK_POSTINGS(["Generer ecritures<br/>comptables"])
      UC_BANK_VIEW(["Consulter transactions<br/>par session"])
      UC_BANK_REPORTS(["Generer rapports<br/>PDF / texte"])
    end

    subgraph Cross["Transverse"]
      UC_AUDIT(["Tracer actions<br/>metier"])
      UC_NOTIFY(["Notifier acteurs<br/>concernes"])
    end
  end

  User --> UC_AUTH
  User --> UC_PROFILE

  Admin --> UC_USERS
  Admin --> UC_PERMISSIONS
  Admin --> UC_DASHBOARD
  Admin --> UC_TPE_MANAGE
  Admin --> UC_MERCHANT_MANAGE
  Admin --> UC_REQUEST_CREATE
  Admin --> UC_REQUEST_INPUT
  Admin --> UC_REQUEST_AUTHORIZE
  Admin --> UC_AFFECT
  Admin --> UC_RATE_INPUT
  Admin --> UC_RATE_AUTHORIZE
  Admin --> UC_FAILURE_REPAIR
  Admin --> UC_BANK_IMPORT

  Monetique --> UC_DASHBOARD
  Monetique --> UC_POWERBI
  Monetique --> UC_TPE_MANAGE
  Monetique --> UC_TPE_IMPORT
  Monetique --> UC_MERCHANT_MANAGE
  Monetique --> UC_REQUEST_FOLLOW
  Monetique --> UC_AFFECT
  Monetique --> UC_SERVICE
  Monetique --> UC_FAILURE_DECLARE
  Monetique --> UC_FAILURE_REPAIR
  Monetique --> UC_BANK_IMPORT
  Monetique --> UC_BANK_REPORTS

  Agence --> UC_TPE_VIEW
  Agence --> UC_MERCHANT_VIEW
  Agence --> UC_REQUEST_CREATE
  Agence --> UC_REQUEST_FOLLOW
  Agence --> UC_ATTACH
  Agence --> UC_CLOSE_REQUEST
  Agence --> UC_FAILURE_DECLARE
  Agence --> UC_FAILURE_VIEW

  Inputer --> UC_REQUEST_INPUT
  Inputer --> UC_RATE_INPUT
  Inputer --> UC_RATE_SUBMIT
  Inputer --> UC_RATE_VIEW

  Authorizer --> UC_REQUEST_AUTHORIZE
  Authorizer --> UC_RATE_AUTHORIZE
  Authorizer --> UC_RATE_VIEW

  PowerBI --- UC_POWERBI
  BankFlow --- UC_BANK_IMPORT

  UC_PROFILE -. include .-> UC_ACCESS
  UC_DASHBOARD -. include .-> UC_ACCESS
  UC_DASHBOARD -. include .-> UC_ANALYTICS
  UC_EXPORT -. include .-> UC_ANALYTICS
  UC_POWERBI -. extend .-> UC_ANALYTICS

  UC_TPE_MANAGE -. include .-> UC_TPE_VIEW
  UC_TPE_STATUS -. extend .-> UC_TPE_MANAGE
  UC_TPE_IMPORT -. include .-> UC_TPE_MANAGE
  UC_TPE_IMPORT_RECORDS -. extend .-> UC_TPE_IMPORT
  UC_TID -. extend .-> UC_TPE_MANAGE

  UC_MERCHANT_MANAGE -. include .-> UC_MERCHANT_VIEW
  UC_MERCHANT_STATUS -. extend .-> UC_MERCHANT_MANAGE

  UC_REQUEST_CREATE -. include .-> UC_RESOLVE_MERCHANT
  UC_RESOLVE_MERCHANT -. include .-> UC_MERCHANT_VIEW
  UC_RESOLVE_MERCHANT -. extend .-> UC_MERCHANT_MANAGE
  UC_ATTACH -. extend .-> UC_REQUEST_FOLLOW
  UC_REQUEST_INPUT -. extend .-> UC_REQUEST_FOLLOW
  UC_REQUEST_INPUT -. include .-> UC_TID
  UC_REQUEST_AUTHORIZE -. extend .-> UC_REQUEST_FOLLOW
  UC_REQUEST_AUTHORIZE -. include .-> UC_FOUR_EYES
  UC_AFFECT -. extend .-> UC_REQUEST_AUTHORIZE
  UC_AFFECT -. include .-> UC_TPE_VIEW
  UC_SERVICE -. extend .-> UC_AFFECT
  UC_CLOSE_REQUEST -. extend .-> UC_REQUEST_FOLLOW

  UC_RATE_SUBMIT -. extend .-> UC_RATE_INPUT
  UC_RATE_AUTHORIZE -. include .-> UC_RATE_VIEW
  UC_RATE_AUTHORIZE -. include .-> UC_FOUR_EYES

  UC_FAILURE_REPAIR -. include .-> UC_FAILURE_VIEW
  UC_FAILURE_ASSIGN -. extend .-> UC_FAILURE_VIEW
  UC_FAILURE_REPLACE -. extend .-> UC_FAILURE_REPAIR
  UC_FAILURE_EXPORT -. include .-> UC_FAILURE_VIEW

  UC_BANK_IMPORT -. include .-> UC_BANK_PROCESS
  UC_BANK_PROCESS -. include .-> UC_BANK_VERIFY
  UC_BANK_PROCESS -. include .-> UC_BANK_POSTINGS
  UC_BANK_REPORTS -. include .-> UC_BANK_VIEW

  UC_TPE_MANAGE -. include .-> UC_AUDIT
  UC_MERCHANT_MANAGE -. include .-> UC_AUDIT
  UC_REQUEST_CREATE -. include .-> UC_AUDIT
  UC_REQUEST_CREATE -. include .-> UC_NOTIFY
  UC_REQUEST_AUTHORIZE -. include .-> UC_AUDIT
  UC_REQUEST_AUTHORIZE -. include .-> UC_NOTIFY
  UC_AFFECT -. include .-> UC_AUDIT
  UC_AFFECT -. include .-> UC_NOTIFY
  UC_RATE_INPUT -. include .-> UC_AUDIT
  UC_RATE_AUTHORIZE -. include .-> UC_AUDIT

  classDef actor fill:#FFFFFF,stroke:#111827,color:#111827,stroke-width:1.2px;
  classDef usecase fill:#F8FAFC,stroke:#2563EB,color:#111827,stroke-width:1.2px;
  classDef external fill:#ECFEFF,stroke:#0891B2,color:#111827,stroke-width:1.2px;

  class User,Admin,Monetique,Agence,Inputer,Authorizer actor;
  class PowerBI,BankFlow external;
  class UC_AUTH,UC_PROFILE,UC_USERS,UC_PERMISSIONS,UC_ACCESS,UC_DASHBOARD,UC_ANALYTICS,UC_EXPORT,UC_POWERBI,UC_TPE_VIEW,UC_TPE_MANAGE,UC_TPE_STATUS,UC_TPE_IMPORT,UC_TPE_IMPORT_RECORDS,UC_TID,UC_MERCHANT_VIEW,UC_MERCHANT_MANAGE,UC_MERCHANT_STATUS,UC_REQUEST_CREATE,UC_REQUEST_FOLLOW,UC_ATTACH,UC_RESOLVE_MERCHANT,UC_REQUEST_INPUT,UC_REQUEST_AUTHORIZE,UC_AFFECT,UC_SERVICE,UC_CLOSE_REQUEST,UC_RATE_INPUT,UC_RATE_SUBMIT,UC_RATE_AUTHORIZE,UC_RATE_VIEW,UC_FOUR_EYES,UC_FAILURE_DECLARE,UC_FAILURE_VIEW,UC_FAILURE_ASSIGN,UC_FAILURE_REPAIR,UC_FAILURE_REPLACE,UC_FAILURE_EXPORT,UC_BANK_IMPORT,UC_BANK_PROCESS,UC_BANK_VERIFY,UC_BANK_POSTINGS,UC_BANK_VIEW,UC_BANK_REPORTS,UC_AUDIT,UC_NOTIFY usecase;
