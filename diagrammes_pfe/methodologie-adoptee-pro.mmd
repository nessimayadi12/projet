%%{init: {'theme':'default', 'themeVariables': { 'fontSize': '16px', 'fontFamily': 'arial'}, 'flowchart': {'htmlLabels': true, 'nodeSpacing': 80, 'rankSpacing': 100}}}%%

flowchart LR
    %% Classes de style
    classDef phase fill:#2E7D87,stroke:#1b4f56,stroke-width:3px,color:#fff,font-weight:bold
    classDef activity fill:#5DADE2,stroke:#2874A6,stroke-width:2px,color:#fff
    classDef deliverable fill:#F8B195,stroke:#E67E22,stroke-width:2px,color:#000,font-weight:bold
    classDef tool fill:#7FB3D5,stroke:#3498DB,stroke-width:2px,color:#fff
    classDef outcome fill:#90EE90,stroke:#27AE60,stroke-width:3px,color:#000,font-weight:bold
    classDef approach fill:#D7BDE2,stroke:#8E44AD,stroke-width:2px,color:#000
    classDef stakeholder fill:#F7DC6F,stroke:#D68910,stroke-width:2px,color:#000,font-weight:bold
    
    %% Approach box
    APPROACH["🎯 Approche Adoptée<br/>Agile / Scrum<br/>(Itérations courtes, feedback continu)"]:::approach
    
    %% Phase 1
    P1["📋 PHASE 1<br/>Planification & Analyse"]:::phase
    A1["Recueil des besoins<br/>Modélisation métier<br/>Conception techique"]:::activity
    D1["Specs détaillées<br/>Architecture<br/>Plan de sprint"]:::deliverable
    
    %% Phase 2
    P2["🏗️ PHASE 2<br/>Conception Détaillée"]:::phase
    A2["Design BDD<br/>Architecture système<br/>Maquettes UI"]:::activity
    D2["MCD/MLD<br/>Diagrammes architecte<br/>User stories détaillées"]:::deliverable
    
    %% Phase 3
    P3["💻 PHASE 3<br/>Développement"]:::phase
    A3["Implémentation Frontend<br/>Implémentation Backend<br/>Intégration API"]:::activity
    D3["Code source<br/>Composants testés<br/>Services implémentés"]:::deliverable
    
    %% Phase 4
    P4["✅ PHASE 4<br/>Tests & Validation"]:::phase
    A4["Tests unitaires<br/>Tests intégration<br/>Validation métier"]:::activity
    D4["Rapports de test<br/>Cas de test<br/>Validation UAT"]:::deliverable
    
    %% Phase 5
    P5["🚀 PHASE 5<br/>Deployment & Clôture"]:::phase
    A5["Préparation production<br/>Documentation finale<br/>Handover"]:::activity
    D5["Livraison système<br/>Documentation<br/>Soutenance"]:::deliverable
    
    %% Itérations
    ITER["🔄 Itérations Courtes<br/>(1-2 semaines)<br/>Review & Rétrospective"]:::approach
    
    %% Stakeholders
    STAKE["👥 Parties prenantes<br/>Product Owner<br/>Scrum Master<br/>Équipe Dev<br/>Clients"]:::stakeholder
    
    %% Tools
    TOOLS["🛠️ Outils utilisés<br/>Git/GitLab<br/>Jira/Trello<br/>Angular/Spring Boot<br/>Maven/npm"]:::tool
    
    %% Outcomes
    OUTCOME["🏆 Livrable Final<br/>Système complet<br/>Documentation<br/>Équipe formée"]:::outcome
    
    %% Connections
    APPROACH --> P1
    STAKE -.->|Guidance| P1
    TOOLS -.->|Support| P1
    A1 --> D1 --> P2
    A2 --> D2 --> P3
    A3 --> D3 --> P4
    A4 --> D4 --> P5
    A5 --> D5 --> OUTCOME
    D5 -.->|Feedback| ITER
    ITER -.->|Amélioration| A3
    
    style APPROACH fill:#9B59B6,stroke:#6C3483,stroke-width:3px,color:#fff,font-weight:bold
    style ITER fill:#9B59B6,stroke:#6C3483,stroke-width:3px,color:#fff,font-weight:bold
    style STAKE fill:#F39C12,stroke:#C87F0A,stroke-width:3px,color:#fff,font-weight:bold
    style TOOLS fill:#3498DB,stroke:#2874A6,stroke-width:3px,color:#fff,font-weight:bold
    style OUTCOME fill:#27AE60,stroke:#1E8449,stroke-width:3px,color:#fff,font-weight:bold
